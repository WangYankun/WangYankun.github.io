/* Custom Styles for 王彦坤的博客 */

/* Clean and minimal design with more whitespace */
body {
  font-size: 16px;
  line-height: 1.8;
}

/* Improve article readability */
.post-body {
  font-size: 16px;
  line-height: 1.8;
}

.post-body p {
  margin: 1.2em 0;
}

/* Clean heading styles */
.post-body h1,
.post-body h2,
.post-body h3 {
  margin-top: 1.5em;
  margin-bottom: 0.8em;
  font-weight: 600;
}

/* Clean blockquote */
.post-body blockquote {
  border-left: 3px solid #ccc;
  color: #666;
  padding-left: 1em;
  margin: 1.5em 0;
}

/* Code block improvements */
.post-body pre {
  border-radius: 6px;
  margin: 1.5em 0;
}

/* Link styles */
.post-body a {
  color: #37c6c6;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.2s;
}

.post-body a:hover {
  border-bottom-color: #37c6c6;
}

/* Image styles */
.post-body img {
  border-radius: 6px;
  margin: 1.5em auto;
}

/* Clean footer */
.footer {
  color: #999;
  font-size: 14px;
}

/* Reading progress bar */
.reading-progress-bar {
  background: linear-gradient(90deg, #37c6c6, #2c9e9e);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .post-body {
    font-size: 15px;
  }
  
  .header-inner {
    padding: 0 15px;
  }
}
